# 1. Sanity.io Headless CMS Configuration
# Get these from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# 2. Resend API Configuration for Working Contact Form
# Get your free API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# 3. Notification Email Targets
CONTACT_RECEIVER_EMAIL=cascadetechnologiessolutions@gmail.com
RESEND_FROM_EMAIL=CascadeTech Solutions <onboarding@resend.dev>

# 4. Base Site URL
NEXT_PUBLIC_SITE_URL=https://cascadetech.in
